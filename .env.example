# Velora AI Website Environment Variables

# Public Client Variables (accessible in browser)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-Only Telegram Bot Variables (@VlgSignal_bot)
# NEVER prefix with NEXT_PUBLIC_ — strictly server-side
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Database (optional for in-memory / local dev)
DATABASE_URL=
